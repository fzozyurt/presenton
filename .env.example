# =============================================================================
# Presenton — Local Development Environment Variables
# =============================================================================
# Copy this file to servers/nextjs/.env.local and servers/fastapi/.env
# and fill in the values for your setup.
# =============================================================================

# ---- Required ----
APP_DATA_DIRECTORY=./app_data
NEXT_PUBLIC_FAST_API=http://localhost:8000
NEXT_PUBLIC_URL=http://localhost:3000
DATABASE_URL=sqlite+aiosqlite:///./app_data/fastapi.db

# ---- Auth (set for local dev without Docker) ----
DISABLE_AUTH=true
# AUTH_USERNAME=admin
# AUTH_PASSWORD=password
# AUTH_SECRET_KEY=change-me-to-a-random-string

# ---- LLM Provider (pick one) ----
LLM=openai
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o
# LLM=google
# GOOGLE_API_KEY=xxx
# GOOGLE_MODEL=gemini-2.5-pro
# LLM=ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ---- Image Provider ----
# IMAGE_PROVIDER=pexels
# PEXELS_API_KEY=xxx
# DISABLE_IMAGE_GENERATION=true

# ---- Optional ----
# CAN_CHANGE_KEYS=true
# MIGRATE_DATABASE_ON_STARTUP=true
# TEMP_DIRECTORY=./tmp
# DISABLE_THINKING=false
# WEB_GROUNDING=false

# ---- OIDC (only if OIDC_ENABLED=true) ----
# OIDC_ENABLED=true
# OIDC_ISSUER=https://auth.example.com/realms/my-realm
# OIDC_CLIENT_ID=presenton
# OIDC_CLIENT_SECRET=xxx
# OIDC_REDIRECT_URI=http://localhost:3000/api/v1/oidc/callback
# OIDC_SCOPES=openid profile email

# ---- Export (PDF/PPTX) ----
# EXPORT_PACKAGE_ROOT=./presentation-export
# EXPORT_RUNTIME_DIR=./presentation-export
# BUILT_PYTHON_MODULE_PATH=./presentation-export/py/convert

# ---- Integration credentials encryption ----
# INTEGRATION_MASTER_KEY=change-me
# INTEGRATION_KEY_FILE=./app_data/.integration_key

# ---- Monitoring (optional) ----
# SENTRY_DSN=https://xxx@sentry.io/xxx
# SENTRY_TRACES_SAMPLE_RATE=1.0
